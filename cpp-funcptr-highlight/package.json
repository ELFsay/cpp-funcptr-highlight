{
  "name": "cpp-funcptr-highlight",
  "displayName": "C/C++ Function Pointer Highlight",
  "description": "为 C/C++ 结构体函数指针调用 (obj.func(...) / ptr->func(...)) 提供金黄色函数高亮，不影响原生 IntelliSense。",
  "version": "1.0.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "contributes": {
    "configuration": {
      "title": "C/C++ Function Pointer Highlight",
      "properties": {
        "cppFuncPtr.highlightColor": {
          "type": "string",
          "default": "#DCDCAA",
          "description": "结构体函数指针调用的高亮颜色（默认金黄色 #DCDCAA，对应 Dark+ 主题函数前景色）"
        },
        "cppFuncPtr.enableSemanticTokens": {
          "type": "boolean",
          "default": false,
          "description": "是否注册语义 Token Provider。注意：VS Code 对同一文档只采用一个 Semantic Tokens Provider，开启后可能与 IntelliSense 互斥导致原生语义高亮失效，建议保持 false，默认使用装饰器方案。"
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "c",
        "scopes": {
          "function": ["entity.name.function"]
        }
      },
      {
        "language": "cpp",
        "scopes": {
          "function": ["entity.name.function.member"]
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.4.5"
  }
}
